<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not the window: saves, edits, the world generator, live mode, blueprints,
       settings. Used by the app (Desktop), the tests and WorldCheck. -->
  <PropertyGroup>
    <!-- The .NET analyzers' recommended rules; CI builds with warnings as errors (.circleci/config.yml). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimWorldEditor.Core</AssemblyName>
    <RootNamespace>TerrainEditor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ValheimWorldEditor" />
    <InternalsVisibleTo Include="Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="WorldGen/terrain-modifiers.json" LogicalName="TerrainEditor.terrain-modifiers.json" />
    <EmbeddedResource Include="WorldGen/pieces.json" LogicalName="TerrainEditor.pieces.json" />
    <EmbeddedResource Include="WorldGen/prefabs.json" LogicalName="TerrainEditor.prefabs.json" />
    <EmbeddedResource Include="WorldGen/vegetation.json" LogicalName="TerrainEditor.vegetation.json" />
    <EmbeddedResource Include="WorldGen/zdo-keys.json" LogicalName="TerrainEditor.zdo-keys.json" />
    <EmbeddedResource Include="WorldGen/cave-rocks.json" LogicalName="TerrainEditor.cave-rocks.json" />
    <EmbeddedResource Include="WorldGen/piece-support.json" LogicalName="TerrainEditor.piece-support.json" />
  </ItemGroup>
</Project>
