<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer checks of the world generator and the save writer against the game (not shipped):
       dotnet run, project tools/WorldCheck, then the check and its arguments (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>TerrainEditor.WorldCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../editor/Core/ValheimWorldEditor.Core.csproj" />
    <!-- The contents and vegetation checks read Expand World Data's files with the add-on's readers. -->
    <ProjectReference Include="../../addons/ExpandWorld/src/ExpandWorld.WorldEditor/ExpandWorld.WorldEditor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The add-on's tests check how the checks read the mods' files (ExpandWorldFiles). -->
    <InternalsVisibleTo Include="ExpandWorld.WorldEditor.Tests" />
  </ItemGroup>
</Project>
