<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer checks of the world generator and the save writer against the game (not shipped):
       dotnet run, project tools/WorldCheck, then the check and its arguments (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>TerrainEditor.WorldCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/ValheimWorldEditor.Core.csproj" />
  </ItemGroup>
</Project>
