<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDK's sample extension (docs/modding.md#extensions), for a made-up mod, "Example Vehicles",
       whose vehicles are a hull and the parts built on it: its packed lists of ids read in the
       inspector and rewritten in pasted copies, its sails drawn from their corners, its cables drawn
       from post to post, the ground left undrawn over its pits, its canals dug as a layer over the area. A template for a mod's own extension; the editor never loads it by itself.
       Built and tested with the editor's tests. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ExampleVehicles.WorldEditor</AssemblyName>
    <RootNamespace>ExampleVehicles.WorldEditor</RootNamespace>
  </PropertyGroup>
  <!-- Compiled against, not shipped: the editor gives its own copy. In the editor's repository, its
       SDK project; from the SDK's zip, the DLL beside the samples folder. -->
  <ItemGroup Condition="Exists('../../ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj')">
    <ProjectReference Include="../../ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj')">
    <Reference Include="ValheimWorldEditor.Sdk" HintPath="../../ValheimWorldEditor.Sdk.dll" Private="false" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>
</Project>
