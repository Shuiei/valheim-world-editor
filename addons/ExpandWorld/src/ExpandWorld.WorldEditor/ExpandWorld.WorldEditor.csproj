<Project Sdk="Microsoft.NET.Sdk">
  <!-- The add-on: worlds made with Expand World Size, Data and Rivers in the editor, generated by the rules read from
       the mods' settings and data files, as an extension the editor loads from its addons folder (docs/modding.md#add-ons).
       net10.0, as the editor runs: the rules model is the SDK's net10.0 build, and Expand World Data's files are read
       with the player's own YamlDotNet, loaded at run time. One DLL: the editor loads nothing else from the add-on's
       folder. Built against the SDK, never the editor itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExpandWorld.WorldEditor</AssemblyName>
    <RootNamespace>ExpandWorld.WorldEditor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compiled against, not shipped: the editor gives its own copy. -->
    <ProjectReference Include="../../../../sdk/ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="worldeditor.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
