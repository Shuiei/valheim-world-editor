  "extension": "ValheimRAFT.WorldEditor.dll",
  "data": {
    "PersistentID": { "label": "Persistent id", "readOnly": true, "help": "The id the pieces built on this object, the ropes tied to it and the switches moving it name it by." },
    "MBParentId": { "label": "Vehicle", "readOnly": true, "help": "The vehicle this piece is built on (its persistent id)." },
    "SwivelParentId": { "label": "Swivel", "readOnly": true, "help": "The swivel this piece is built on (its persistent id): the piece turns with it." },
    "MBPosition": { "label": "Place on the vehicle", "readOnly": true, "help": "Where the mod builds this piece, in metres, in the frame of the vehicle or swivel it is built on." },
    "MBRotationVec": { "label": "Turn on the vehicle", "readOnly": true, "help": "How the mod turns this piece on the vehicle or swivel it is built on, in degrees." },
    "MBRotation": { "label": "Turn on the vehicle (old)", "readOnly": true, "help": "The turn older versions of the mod kept, as a quaternion." },
    "MBPieceCount": { "label": "Pieces", "readOnly": true, "help": "How many pieces the mod counted on this vehicle." },
    "VehicleChunkBounds": { "label": "Hull bounds", "readOnly": true, "help": "The boxes the mod's boundary tools set for this vehicle's hull." },
    "VehicleTempPieceParentId": { "label": "Carried by", "readOnly": true, "help": "The vehicle carrying this object (a cart, an animal): the mod moves it with the vehicle." },
    "MBCultivatableParentId": { "label": "Planted in", "readOnly": true, "help": "The soil piece this plant grows in." },
    "Mechanism_swivelTargetId": { "label": "Swivel it moves", "help": "The swivel this switch moves (its persistent id)." },
    "MBRopeAnchor_Ropes": { "label": "Ropes", "readOnly": true, "help": "What this anchor's ropes are tied to." },
    "SailParentId": { "label": "Mast", "readOnly": true, "help": "The mast this sail hangs on (its persistent id)." },
    "m_sailCornersCountHash": { "label": "Sail corners", "readOnly": true, "help": "How many corners the mod weaves this sail between." },
    "m_sailCorner1Hash": { "label": "Sail corner 1", "readOnly": true, "help": "A corner of the sail, in metres, in its frame." },
    "m_sailCorner2Hash": { "label": "Sail corner 2", "readOnly": true, "help": "A corner of the sail, in metres, in its frame." },
    "m_sailCorner3Hash": { "label": "Sail corner 3", "readOnly": true, "help": "A corner of the sail, in metres, in its frame." },
    "m_sailCorner4Hash": { "label": "Sail corner 4", "readOnly": true, "help": "A corner of the sail, in metres, in its frame." },
    "m_mainColor": { "label": "Sail colour", "readOnly": true },
    "m_patternColor": { "label": "Sail pattern colour", "readOnly": true },
    "m_logoColor": { "label": "Sail logo colour", "readOnly": true }
