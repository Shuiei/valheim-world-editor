<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Railroads add-on's tests, on the .NET the editor runs on, with the SDK as the editor hands it over: the real
       Railroads downloaded for the tests (editor/tests/TestMods.targets, this project's own list: the mod only), and
       objects recorded on a server running Railroads (railroads-reference.txt). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test methods need no doc comment: their names say what they check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The editor's tests' settings (a stuck test dumped and stopped after 5 minutes), for dotnet test. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --config-file $(MSBuildThisFileDirectory)../../../../editor/tests/testconfig.json</TestingPlatformCommandLineArguments>
    <!-- Only Railroads is downloaded (below), not the editor's own test mods. -->
    <TestModsOwnList>true</TestModsOwnList>
  </PropertyGroup>
  <ItemGroup>
    <!-- As the editor's tests: xUnit on Microsoft.Testing.Platform, the JUnit results CI shows (with the test
         platform's object model the logger needs), the coverage on main and a stuck test's dump. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="JunitXml.TestLogger" Version="8.0.0" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Railroads.WorldEditor/Railroads.WorldEditor.csproj" />
    <ProjectReference Include="../../../../sdk/ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj" />
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The editor's tests' downloader of the real mods (its folder, and their deletion when the run ends). -->
    <Compile Include="../../../../editor/tests/Support/TestMods.cs" Link="Support/TestMods.cs" />
    <!-- The fake host's game world data: none (shared with the other add-ons' tests). -->
    <Compile Include="../../../../editor/tests/Support/NoWorldGameData.cs" Link="Support/NoWorldGameData.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The version of the mod the add-on follows, as Thunderstore has it. -->
    <TestMod Include="VladasZ-Railroads" Owner="VladasZ" Package="Railroads" Version="0.2.6" Dll="plugins/Railroads/Railroads.dll" />
  </ItemGroup>
  <Import Project="../../../../editor/tests/TestMods.targets" />
</Project>
