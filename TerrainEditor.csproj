<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimWorldEditor</AssemblyName>
    <!-- A window app on Windows: no console window behind it (output goes to log.txt). -->
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>wwwroot/icon.ico</ApplicationIcon>
    <RootNamespace>TerrainEditor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The BepInEx bridge plugin and tools are separate projects. -->
    <Compile Remove="plugin/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="tests/**" />
    <!-- The shared library is its own project (Core/), referenced below. -->
    <Compile Remove="Core/**" />
    <Compile Remove="Desktop/**" />
    <None Remove="Desktop/**" />
    <Content Remove="Desktop/**" />
    <EmbeddedResource Remove="Desktop/**" />
    <None Remove="Core/**" />
    <EmbeddedResource Remove="Core/**" />
    <Content Remove="Core/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <None Remove="plugin/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorldEditor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/ValheimWorldEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
