<!-- One version for the editor, the plugin and every package: the VERSION file. The editor and the
     plugin read it as BuildInfo.Version (generated at build time). -->
<Project>
  <!-- Code analysis for every project, as the .NET SDK has it
       (https://learn.microsoft.com/dotnet/fundamentals/code-analysis/overview): the .NET analyzers'
       recommended rules, the code style of .editorconfig checked by the build, Roslynator's analyzers,
       and no warning left: each one fails the build. Every public type and member has a doc
       comment (CS1591), except in the tests, whose names say what they check. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
  </PropertyGroup>
  <Target Name="WriteBuildInfo" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'WorldEditorBridge' Or '$(MSBuildProjectName)' == 'ValheimWorldEditor.Desktop'">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated from VERSION.;internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
