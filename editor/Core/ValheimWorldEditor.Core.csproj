<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not the window: saves, edits, the world generator, live mode, blueprints,
       settings. Used by the app (Desktop), the tests and WorldCheck. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimWorldEditor.Core</AssemblyName>
    <RootNamespace>TerrainEditor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ValheimWorldEditor" />
    <InternalsVisibleTo Include="Desktop.Tests" />
    <InternalsVisibleTo Include="Core.Tests" />
    <InternalsVisibleTo Include="Fuzz" />
    <InternalsVisibleTo Include="AddOns.Tests" />
    <InternalsVisibleTo Include="WorldCheck" />
    <!-- The Expand World add-on's tests: its rules followed by the editor's generator, placer and dungeons. -->
    <InternalsVisibleTo Include="ExpandWorld.WorldEditor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app's texts, a catalogue per language (App/Lang.cs). -->
    <EmbeddedResource Include="Lang/*.json" LogicalName="TerrainEditor.Lang.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API mods' editor extensions are built against (App/ModExtensions.cs). -->
    <ProjectReference Include="../../sdk/ValheimWorldEditor.Sdk/ValheimWorldEditor.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's models and textures, read from its asset bundles (App/GameBundles.cs, GameTextures.cs). -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- The terrain shader from Valheim for Windows (SPIR-V to GLSL, App/TerrainShader.cs). -->
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
  </ItemGroup>
</Project>
