<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of both test projects (dotnet-coverage collect -s tests/coverage.config ...): only code
     written for the editor counts. Left out: Jordan Peck's FastNoise library (which
     WorldGeneratorReferenceTests still checks, with the world generator, against values recorded in
     the game). -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Core[\\/]WorldGen[\\/]FastNoise\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
