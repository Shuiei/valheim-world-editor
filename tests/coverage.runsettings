<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of both test projects (the coverage settings dotnet test is given, as
     .circleci/continue.yml runs them), written as Cobertura for Codecov (codecov.yml).
     Only code written for the editor counts: the core and the app, not the tests, the libraries or
     generated code. Left out too: Jordan Peck's FastNoise library (which WorldGeneratorReferenceTests
     still checks, with the world generator, against values recorded in the game). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]ValheimWorldEditor(\.Core)?\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]Core[\\/]WorldGen[\\/]FastNoise\.cs$</Source>
                <Source>.*\.g\.cs$</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
