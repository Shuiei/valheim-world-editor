<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's tests: its windows and panels run in Avalonia's headless mode (no screen, no OpenGL),
       driven with exact mouse and keyboard input. Laid out like Desktop, one test class per file named
       after the file it tests; Integration/ holds the tests of several files at once (window workflows,
       live mode, the visual tests), Support/ (here and tests/Support) their helpers. -->
  <PropertyGroup>
    <!-- CI builds them with warnings as errors (.circleci/config.yml). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>TerrainEditor.Desktop.Tests</RootNamespace>
    <!-- Test methods need no doc comment: their names say what they check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.3.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="JunitXml.TestLogger" Version="7.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The helpers both test projects share: the test world, the fixtures, a stand-in game. -->
    <Compile Include="../Support/**/*.cs" LinkBase="Support/Shared" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Desktop/ValheimWorldEditor.Desktop.csproj" />
  </ItemGroup>
</Project>
