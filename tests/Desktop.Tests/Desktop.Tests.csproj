<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native app's tests: its windows and panels run in Avalonia's headless mode (no screen, no
       OpenGL), driven with exact mouse and keyboard input. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>TerrainEditor.Desktop.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="JunitXml.TestLogger" Version="4.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Desktop/ValheimWorldEditor.Desktop.csproj" />
  </ItemGroup>
</Project>
