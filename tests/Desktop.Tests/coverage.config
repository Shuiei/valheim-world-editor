<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the native tests (dotnet-coverage collect -s tests/Desktop.Tests/coverage.config ...):
     only code written for the editor counts. Left out: Jordan Peck's FastNoise library, and the
     world generator and its helpers decompiled from Valheim. CoreGenReferenceTests still checks
     all three against values recorded in the game. -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Core[\\/]WorldGen[\\/]FastNoise\.cs$</Source>
        <Source>.*[\\/]Core[\\/]WorldGen[\\/]WorldGenerator\.cs$</Source>
        <Source>.*[\\/]Core[\\/]WorldGen[\\/]DUtils\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
