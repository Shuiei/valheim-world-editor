<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app: an Avalonia window, the 3D view and the map drawn with OpenGL. Uses the Core library. -->
  <PropertyGroup>
    <!-- The .NET analyzers' recommended rules; CI builds with warnings as errors (.circleci/config.yml). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimWorldEditor</AssemblyName>
    <RootNamespace>TerrainEditor.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published as one file. On Linux its native libraries (Skia, HarfBuzz, SPIRV-Cross) are packed
         inside it too; on Windows they stay beside the .exe: a program that writes DLLs to a temporary
         folder and loads them is what antivirus heuristics take for a dropper. -->
    <IncludeNativeLibrariesForSelfExtract Condition="!$(RuntimeIdentifier.StartsWith('win'))">true</IncludeNativeLibrariesForSelfExtract>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <!-- The program's details (Windows shows them in its Properties and in the Task Manager); a program
         without them looks more suspect to antivirus heuristics. -->
    <Product>Valheim World Editor</Product>
    <AssemblyTitle>Valheim World Editor</AssemblyTitle>
    <Description>A world editor for Valheim: shape the ground, build, place and move objects, edit dungeons, offline or live.</Description>
    <Company>Shuiei</Company>
    <Authors>Shuiei</Authors>
    <Copyright>Copyright (c) 2026 Shuiei</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The window's icon (Windows also takes the program's, ApplicationIcon). -->
    <AvaloniaResource Include="Assets/icon.png" />
    <!-- The Script tool's API, compiled with each script. -->
    <EmbeddedResource Include="ScriptApi.csx" LogicalName="TerrainEditor.ScriptApi.csx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/ValheimWorldEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <!-- The Script tool: C# scripts compiled in the app (Roslyn), against .NET's reference assemblies
         carried inside (a single-file app has no assembly files to point the compiler at). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <!-- Claude's connection (Settings: Allow Claude to connect): an MCP server inside the app, on
         127.0.0.1 only (ClaudeServer.cs), with ASP.NET Core's web server. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
