<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native app (Avalonia window, 3D view drawn with OpenGL), next to the web app until it does
       everything the web one does. Uses the shared Core library. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimWorldEditor</AssemblyName>
    <RootNamespace>TerrainEditor.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The window's icon (Windows also takes the program's, ApplicationIcon). -->
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/ValheimWorldEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>
</Project>
