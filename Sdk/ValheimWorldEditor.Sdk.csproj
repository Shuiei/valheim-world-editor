<Project Sdk="Microsoft.NET.Sdk">
  <!-- What a mod builds an editor extension against (docs/modding.md#extensions): the interfaces the
       editor calls and the values it hands over, nothing of the editor itself. netstandard2.0, so a
       mod's own projects (net472 for the game) can share code with their extension. Released as
       ValheimWorldEditor.Sdk.dll with each editor version; the editor loads extensions against its
       own copy. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ValheimWorldEditor.Sdk</AssemblyName>
    <RootNamespace>ValheimWorldEditor.Sdk</RootNamespace>
    <!-- The API's version, not the editor's: extensions bind to it, so it only changes when the API
         breaks (SdkInfo.ApiVersion). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Vector3 and Quaternion, which netstandard2.0 does not hold; the game and .NET both have them. -->
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>
</Project>
